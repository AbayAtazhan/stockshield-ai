# =============================================================================
# StockShield AI - Environment Configuration Example
# AMD Developer Hackathon MVP
# =============================================================================

# Fireworks AI Inference Endpoint (Optional: simulation active if omitted)
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Endpoint Base URL (Fireworks Cloud or local AMD ROCm vLLM server)
# Cloud Default: https://api.fireworks.ai/inference/v1
# Local AMD ROCm: http://localhost:8000/v1
LLM_BASE_URL=https://api.fireworks.ai/inference/v1

# Target LLM Model
# Gemma 2 27B (Primary AMD Instinct MI300X target)
LLM_MODEL=accounts/fireworks/models/gemma-2-27b-it
LLM_FALLBACK_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# Hugging Face Token (Required only when downloading local weights for ROCm vLLM)
HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here
